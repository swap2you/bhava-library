{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bhava.local/schemas/download-job.json",
  "title": "Download Job",
  "type": "object",
  "required": [
    "job_id",
    "resource_id",
    "state",
    "url"
  ],
  "properties": {
    "job_id": {
      "type": "string"
    },
    "resource_id": {
      "type": "string"
    },
    "state": {
      "enum": [
        "pending",
        "active",
        "paused",
        "retryable",
        "terminal_failure",
        "complete"
      ]
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "expected_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "bytes_downloaded": {
      "type": "integer",
      "minimum": 0
    },
    "part_path": {
      "type": "string"
    },
    "etag": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_modified": {
      "type": [
        "string",
        "null"
      ]
    },
    "sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": true
}
