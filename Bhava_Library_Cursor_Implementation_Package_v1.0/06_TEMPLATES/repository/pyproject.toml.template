[project]
name = "bhava-library"
version = "0.1.0"
description = "Private local-first devotional educational reference library"
requires-python = ">=3.13,<3.15"
dependencies = [
  "beautifulsoup4",
  "filetype",
  "httpx",
  "platformdirs",
  "pydantic",
  "pydantic-settings",
  "rich",
  "tenacity",
  "typer",
]

[project.optional-dependencies]
ui = ["fastapi", "jinja2", "uvicorn"]
dev = [
  "bandit",
  "coverage",
  "hypothesis",
  "mypy",
  "pip-audit",
  "pytest",
  "pytest-httpx",
  "ruff",
]

[project.scripts]
bhava-lib = "bhava_library.cli:app"

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-ra --strict-markers --strict-config"

[tool.ruff]
target-version = "py313"
line-length = 100

[tool.mypy]
python_version = "3.13"
strict = true
warn_unreachable = true
