{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bhava.local/schemas/resource.json",
  "title": "Bhava Library Resource",
  "type": "object",
  "required": [
    "resource_id",
    "source_id",
    "title_original",
    "original_url",
    "status"
  ],
  "properties": {
    "resource_id": {
      "type": "string",
      "pattern": "^BL-[A-Z0-9-]+$"
    },
    "source_id": {
      "type": "string"
    },
    "title_original": {
      "type": "string",
      "minLength": 1
    },
    "title_normalized": {
      "type": "string"
    },
    "level": {
      "type": [
        "string",
        "null"
      ]
    },
    "media_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "media_format": {
      "type": [
        "string",
        "null"
      ]
    },
    "theme": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "original_url": {
      "type": "string",
      "format": "uri"
    },
    "resolved_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "profile": {
      "enum": [
        "metadata",
        "core",
        "audio",
        "video",
        "unknown"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "discovered",
        "resolving",
        "resolved",
        "unresolved",
        "inaccessible",
        "estimated",
        "size_unknown",
        "queued",
        "downloading",
        "paused",
        "failed_retryable",
        "failed_terminal",
        "downloaded",
        "verifying",
        "verified",
        "quarantined",
        "corrupt",
        "indexed"
      ]
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
